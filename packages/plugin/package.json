{
  "name": "dsh-whale-console",
  "version": "0.3.0-preview.1",
  "description": "Unofficial WebUI skin plugin and launcher bridge for DeepSeek Harness (DSH).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Georgehaoren/DSH-WhaleConsole.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/Georgehaoren/DSH-WhaleConsole#readme",
  "bugs": {
    "url": "https://github.com/Georgehaoren/DSH-WhaleConsole/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE.zh-CN.md",
    "ASSET_LICENSE.md",
    "ASSET_LICENSE.zh-CN.md",
    "AI_DISCLOSURE.md",
    "AI_DISCLOSURE.zh-CN.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ../skins/tsconfig.build.json && node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:composition": "node scripts/verify-dsh-composition.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-theme": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@dsh-whale-console/skins": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.2.0"
  },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "plugin", "skin", "theme", "webui", "launcher"]
}
